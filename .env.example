# Hugging Face access token (UI/API 다운로드 시 사용)
HF_TOKEN=hf_xxx_replace_me

# Base GGUF model file path
BASE_MODEL_PATH=D:/models/Qwen3.6-35B-A3B-UD-Q3_K_XL.gguf

# LoRA adapter file path (gguf 또는 변환 결과)
LORA_ADAPTER_PATH=D:/models/lora/adapter_model.gguf

# llama.cpp runtime options
LLAMA_N_CTX=262144
LLAMA_N_THREADS=8
LLAMA_N_GPU_LAYERS=0

# frontend to backend API
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# runtime selection
INFERENCE_RUNTIME=llama_cpp

# transformers runtime (optional)
HF_BASE_MODEL_ID=gpt2
HF_LORA_MODEL_ID=
